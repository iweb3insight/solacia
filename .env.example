# ToC 情感陪伴机器人 - 环境变量配置

# === LLM 配置 ===
LLM_API_KEY=sk-your-api-key
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# === 服务配置 ===
API_HOST=0.0.0.0
API_PORT=8001

# === 数据库配置 ===
DB_PATH=data/mood_diary.db

# === 对话配置 ===
MAX_CONTEXT_TOKENS=4000
MAX_HISTORY_MESSAGES=50
